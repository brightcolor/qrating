NODE_ENV=production
PORT=4000
ADMIN_APP_URL=https://app.qrating.de
FEEDBACK_APP_URL=https://qrat.ing
CORS_ALLOWED_ORIGINS=

POSTGRES_DB=qrating
POSTGRES_USER=qrating
POSTGRES_PASSWORD=qrating
DATABASE_URL=postgres://qrating:qrating@postgres:5432/qrating
# Bind mount for the database files; leave empty to keep the named Docker volume.
POSTGRES_DATA=./data/postgres

SESSION_SECRET=change-me-at-least-32-chars
PRETIX_TOKEN_SECRET=change-me-32-byte-secret-value!!

ORGANIZATION_NAME=Demo Events
ORGANIZATION_SLUG=demo-events

# Host bindings of the containers.
FRONTEND_PORT=8080
BACKEND_PORT=127.0.0.1:4000
# Proxy hops in front of the API: 1 = only the frontend nginx, 2 = plus a reverse proxy or tunnel.
TRUST_PROXY=1

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
IMAGE_CACHE_MAX_BYTES=5242880
WORKER_INTERVAL_MS=5000
PRETIX_SCHEDULER_INTERVAL_MS=60000

BILLING_ADMIN_EMAILS=

# Every setting below has its default in backend/src/config/env.js. Uncomment a line to change it;
# a value outside what it allows stops the backend at the start with a message that names it.

# Sign-in and sessions
# Name of the cookie that carries the admin session. Allowed: letters, digits, _ and -, up to 64 characters.
# ADMIN_COOKIE_NAME=qrating_admin
# How long a sign-in to the admin area lasts, in hours. Allowed: 1–720.
# ADMIN_SESSION_HOURS=12
# How long the sign-in waits for the code of the authenticator app, in minutes. Allowed: 1–60.
# TWO_FACTOR_CHALLENGE_MINUTES=10
# Minimum length of a password, in characters. Allowed: 8–128.
# PASSWORD_MIN_LENGTH=10
# Lifetime of a password reset link, in hours. Allowed: 1–72.
# PASSWORD_RESET_VALID_HOURS=2
# Lifetime of a team invitation, in days. Allowed: 1–90.
# INVITE_VALID_DAYS=7
# Window for sign-in attempts per address, in minutes. Allowed: 1–1440.
# AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# Sign-in attempts accepted per address within that window. Allowed: 1–100000.
# AUTH_RATE_LIMIT_MAX=20
# Window for password reset requests per address, in minutes. Allowed: 1–1440.
# PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=60
# Password reset requests accepted per address within that window. Allowed: 1–100000.
# PASSWORD_RESET_RATE_LIMIT_MAX=5
# Length of the setup code of the first setup, in characters. Allowed: 12–64.
# SETUP_CODE_LENGTH=16
# Command the setup page names for showing a fresh setup code. Allowed: up to 300 characters.
# SETUP_CODE_COMMAND=docker compose exec backend node src/cli/setup-code.js

# Deletion periods and background jobs
# Shortest deletion period an organization can enter, in days. Allowed: 1–365.
# RETENTION_MIN_DAYS=1
# Longest deletion period an organization can enter, in days. Allowed: 1–36500.
# RETENTION_MAX_DAYS=3650
# Deletion period of callback numbers a new organization starts with, in days; each organization can enter its own. Allowed: 1–36500.
# RETENTION_PHONE_DEFAULT_DAYS=90
# Time between two deletion runs of an organization, in hours. Allowed: 1–720.
# RETENTION_INTERVAL_HOURS=12
# Wait before a failed background job runs again, in minutes. Allowed: 1–1440.
# JOB_RETRY_MINUTES=2
# Attempts of a background job before it counts as failed. Allowed: 1–50.
# JOB_MAX_ATTEMPTS=5
# Attempts of a Pretix sync before it counts as failed. Allowed: 1–50.
# PRETIX_SYNC_MAX_ATTEMPTS=3
# Attempts of a deletion run before it counts as failed. Allowed: 1–50.
# RETENTION_JOB_MAX_ATTEMPTS=2
# Syncs and deletion runs the planner schedules per round at most. Allowed: 1–1000.
# SCHEDULER_BATCH_SIZE=20
# How long finished background jobs stay in the list, in days. Allowed: 1–3650.
# JOB_HISTORY_DAYS=30
# How long the alert after a tap on one or two stars waits for the rest of the form, in minutes; 0 sends it at once. Allowed: 0–1440.
# LOW_RATING_GRACE_MINUTES=30

# Lists in the admin area and the report
# Votes the evaluation of an event lists. Allowed: 1–5000.
# ANALYTICS_VOICES_LIMIT=100
# Comments the evaluation of an event returns. Allowed: 1–5000.
# ANALYTICS_COMMENTS_LIMIT=100
# Abandoned visits the evaluation of an event lists. Allowed: 1–5000.
# ANALYTICS_ABANDONED_LIMIT=200
# Cases the list of callbacks shows. Allowed: 1–5000.
# CALLBACKS_LIST_LIMIT=200
# Comments in the PDF report. Allowed: 1–1000.
# REPORT_COMMENTS_LIMIT=50

# QR places
# Longest name of a QR place, in characters. Allowed: 10–200.
# QR_SOURCE_LABEL_MAX_LENGTH=60
# Longest short name of a QR place in the address, in characters. The guest page reports it back in a field of at most 80 characters. Allowed: 3–80.
# QR_SOURCE_SLUG_MAX_LENGTH=40

# Events and the wallboard
# Upcoming events that can be picked by hand for the page after a rating. Allowed: 1–20.
# UPCOMING_EVENTS_MAX=5
# Longest feedback round after the end of an event, days part. Allowed: 1–3650.
# FEEDBACK_WINDOW_MAX_DAYS=365
# Longest feedback round after the end of an event, hours part. Allowed: 1–87600.
# FEEDBACK_WINDOW_MAX_HOURS=8760
# How often the wallboard reloads while an organization enters nothing, in seconds. Allowed: 1–86400.
# WALLBOARD_REFRESH_DEFAULT_SECONDS=15
# Shortest reload interval of the wallboard, in seconds. Allowed: 1–86400.
# WALLBOARD_REFRESH_MIN_SECONDS=5
# Longest reload interval of the wallboard, in seconds. Allowed: 1–86400.
# WALLBOARD_REFRESH_MAX_SECONDS=3600

# New organizations
# Colour of a new organization, in quotes because of the #. Allowed: a colour as #RRGGBB.
# NEW_ORGANIZATION_COLOR="#2563eb"
# Privacy note of a new organization. Allowed: up to 2000 characters.
# NEW_ORGANIZATION_PRIVACY_TEXT="Feedback ist anonym möglich. E-Mail-Adressen werden nur für den gewählten Zweck gespeichert."
